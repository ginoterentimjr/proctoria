{
  // Proctoria: servidor (Worker), banco (Durable Object com SQLite) e arquivos (R2)
  "name": "proctoria",
  "main": "servidor/index.js",
  "compatibility_date": "2026-09-01",
  "build": { "command": "node servidor/montar.mjs", "watch_dir": "servidor" },
  "assets": { "directory": ".publico", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "BANCO", "class_name": "Banco" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Banco"] }],
  "r2_buckets": [{ "binding": "ARQUIVOS", "bucket_name": "proctoria-arquivos" }],
  "observability": { "enabled": true }
}
